   658  02a8  3d                	dec	a
   659  02a9  20fc              	jr	nz, rt_shl_lp
   660  02ab  c9                	ret
   661                          
   662                          rt_shr:
   663  02ac  7b                	ld	a, e
   664  02ad  b7                	or	a
   665  02ae  c8                	ret	z
   666                          rt_shr_lp:
