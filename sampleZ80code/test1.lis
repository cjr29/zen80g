test1.asm:
     1                          ; test1
     2                          ; Copies a "#" character 64 times into memory
     3                          ; As it copies into memory, it also pushes onto the stack
     4                          ; Result will be 64 bytes of "#" and 64 words on the stack
     5                          ; since the stack operates on words
     6                          ;
     7                          ; Constants
     8                          IHDLR_UNKNOWN: EQU 0x00
     9                          IHDLR_TERMINAL_VECTOR: EQU 0x02
    10                          MONITOR_ROM:   EQU 0x0000
    11                          INTERRUPT_VECTOR_TABLE: EQU 0X0200
    12                          INTERRUPT_VECTOR_TABLE_MSB: EQU 0x02
    13                          DEST1:   EQU 0x4000  ; Destination address for data move tests
    14                          DEST2:  EQU 0x5000      ; Destination for block move
    15                          
    16                          ; 0x0000 - 0x01ff reserved or simulated ROM with System Monitor
    17  0000  0000000000000000  DEFS 512
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
