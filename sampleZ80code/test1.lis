              0000000000000000  
              0000000000000000  
    18                          ; Interrupt Vector Table
    19  0200  0000                      DW IHDLR_UNKNOWN        ; vector 0
    20  0202  1c03                      DW IHDLR_TERMINAL       ; vector 2 - interrupt on keyboard Enter pressed
    21  0204  0000                      DW IHDLR_UNKNOWN        ; vector 4
    22                          ; Reserve remainder of block for IV table
    23  0206  0000000000000000  DEFS 256-6
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
