test1.asm:
     1                          ; test1
     2                          ; Copies a "#" character 64 times into memory
     3                          ; As it copies into memory, it also pushes onto the stack
     4                          ; Result will be 64 bytes of "#" and 64 words on the stack
     5                          ; since the stack operates on words
     6                          ;
     7                          ; Constants
     8                          IHDLR_UNKNOWN: EQU 0x00
     9                          IHDLR_TERMINAL_VECTOR: EQU 0x00
    10                          MONITOR_ROM:   EQU 0x0000
    11                          INTERRUPT_VECTOR_TABLE: EQU 0X0200
    12                          INTERRUPT_VECTOR_TABLE_MSB: EQU 0x02
    13                          TERMINAL_PORT   EQU 0x00
    14                          
    15                          ; 0x0000 - 0x01ff reserved for simulated ROM with System Monitor
    16  0000  0000000000000000  DEFS 512
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
    17                          ; 0x0200 - 0x2ff reserved for interrupt vector table
    18                          ; Interrupt Vector Table
    19                                  ; First 3 words - 2 byte address per vector on even boundary
    20  0200  1003                      DW IHDLR_TERMINAL       ; vector 0 - interrupt on keyboard Enter pressed
    21  0202  0000                      DW IHDLR_UNKNOWN        ; vector 2
    22  0204  0000                      DW IHDLR_UNKNOWN        ; vector 4
    23                          ; Reserve remainder of block for IV table
    24  0206  0000000000000000  DEFS 256-6
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000              
    25                          
    26                          ; Main code starts here
    27                          MAIN:       ; Main program entry point 0x300
    28                          
    29  0300  f3                        DI      ; Disable int during initialization
    30  0301  3e02                      LD A, INTERRUPT_VECTOR_TABLE_MSB
    31  0303  ed47                      LD I, A ; Set Interrupt Vector to MSB of the Interrupt Vector Table address
    32  0305  ed5e                      IM 2    ; Set interrupt mode to 2
    33  0307  fb                        EI      ; Enable interrupts
    34                          
    35                          ; For debugging interrupts, just enter a tight loop waiting for an IM2
    36  0308  00                WAIT:   NOP
    37  0309  00                        NOP
    38  030a  00                        NOP
    39  030b  00                        NOP
    40  030c  00                        NOP
    41  030d  c30803                    JP WAIT
    42                          
    43                          ; Start Interrupt handler code
    44                          IHDLR_TERMINAL:
    45  0310  f3                        DI
    46  0311  f5                        PUSH AF
    47  0312  d5                        PUSH DE
    48  0313  ed5b2403                  LD DE, (INT_COUNT)
    49  0317  13                        INC DE          ; increment interrupt count
    50  0318  ed532403                  LD (INT_COUNT), DE
    51  031c  cd2603                    CALL PROCESS_LINE      ; Process the characters from the terminal
    52  031f  d1                        POP DE
    53  0320  f1                        POP AF
    54  0321  fb                        EI
    55  0322  ed4d                      RETI
    56                          
    57                          ; Data area - CONSTANTS
    58                          HASH:           EQU '#'
    59                          NEWLINE:        EQU 0x0A
    60                          RIGHT_ANGLE_BRACKET     EQU '>'
    61  0324  0000              INT_COUNT:      DW 0x0000       ; var - stores count of interrupts
    62                          
    63                          ; Subroutine that retrieves and tests terminal lines
    64                          PROCESS_LINE:
    65  0326  db00                      IN A,(TERMINAL_PORT)        ; get next available character from terminal port 0
    66                                  ; Test for monitor command, if so, call monitor handler
    67                                  ; otherwise just echo the character until NL
    68  0328  fe23                      CP HASH         ; Is this a monitor command line?
    69  032a  ca3703                    JP Z, MON_CMD   ; Handle as monitor cmd
    70                                  ; Not a monitor command, keep reading chars
    71                                  ; If this was a NL, we are done, return from interrupt
    72  032d  fe0a                      CP NEWLINE
    73  032f  ca4c03                    JP Z, END_TERMIO_IH
    74                                  ; Not end of terminal line, keep reading chars
    75  0332  d300                      OUT (TERMINAL_PORT),A
    76  0334  c34303                    JP FINISH_LINE
    77                          
    78                          MON_CMD:
    79  0337  cd3d03                    Call MONITOR_CMD_HNDLR   ; Handle monitor command
    80  033a  c34c03                    JP END_TERMIO_IH     ; Return to interrupt handler
    81                          ; MONITOR_CMD_HNDLR
    82                          MONITOR_CMD_HNDLR:
    83  033d  f5                        PUSH AF
    84  033e  3e3e                      LD A, RIGHT_ANGLE_BRACKET
    85  0340  d300                      OUT (TERMINAL_PORT), A    ; Write a monitor line start symbol
    86  0342  f1                        POP AF
    87                          FINISH_LINE:    ; process remaining chars from terminal
    88  0343  db00                      IN A, (TERMINAL_PORT)       ; Get next char
    89  0345  d300                      OUT (TERMINAL_PORT), A
    90  0347  fe0a                      CP A, NEWLINE    ; If line feed, done
    91  0349  c24303                    JP NZ, FINISH_LINE           ; Not end, keep reading
    92                          END_TERMIO_IH:
    93  034c  d300                      OUT (TERMINAL_PORT), A ; output the NL and return
    94  034e  c9                        RET
    95                          
